{
  "name": "planmark-desktop",
  "productName": "PlanMark",
  "version": "1.2.1",
  "description": "PlanMark - PDF markup & takeoff (desktop)",
  "author": "PlanMark",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "bash build.sh"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "resedit": "3.1.0"
  },
  "build": {
    "appId": "com.planmark.desktop",
    "productName": "PlanMark",
    "copyright": "PlanMark",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "package.json",
      "web/**/*"
    ],
    "asar": true,
    "asarUnpack": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "artifactName": "PlanMark-${version}-win-${arch}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PlanMark",
      "artifactName": "PlanMark-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "PlanMark",
      "runAfterFinish": true
    },
    "afterPack": "scripts/after-pack.js",
    "publish": null
  }
}